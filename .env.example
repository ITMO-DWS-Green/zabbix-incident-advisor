# По умолчанию LLM выключена: разбор строится шаблоном и ничего не уходит наружу.
ADVISOR_LLM_PROVIDER=stub
ADVISOR_LLM_BASE_URL=http://ollama:11434/v1
ADVISOR_LLM_MODEL=qwen2.5:3b
ADVISOR_LLM_API_KEY=

# Внешняя бесплатная/условно бесплатная LLM через OpenAI-compatible API.
# 1) Получить ключ у провайдера.
# 2) Раскомментировать блок.
# 3) Запустить docker compose --profile stand up -d --build.
#
# OpenRouter: у бесплатных моделей обычно есть суффикс :free, лимиты зависят от аккаунта.
# ADVISOR_LLM_PROVIDER=openai
# ADVISOR_LLM_BASE_URL=https://openrouter.ai/api/v1
# ADVISOR_LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
# ADVISOR_LLM_API_KEY=sk-or-...
#
# Groq: OpenAI-compatible endpoint, бесплатные лимиты зависят от аккаунта.
# ADVISOR_LLM_PROVIDER=openai
# ADVISOR_LLM_BASE_URL=https://api.groq.com/openai/v1
# ADVISOR_LLM_MODEL=llama-3.1-8b-instant
# ADVISOR_LLM_API_KEY=gsk_...
#
# Локально через Ollama (без внешнего API; профиль ollama в compose тянет модель):
# ADVISOR_LLM_PROVIDER=openai
# ADVISOR_LLM_BASE_URL=http://ollama:11434/v1
# ADVISOR_LLM_MODEL=qwen2.5:3b
# ADVISOR_LLM_API_KEY=
